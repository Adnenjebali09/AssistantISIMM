#!/usr/bin/env bash
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
export OLLAMA_HOST=127.0.0.1:11434 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_NUM_PARALLEL=1 OLLAMA_NO_CLOUD=1
export OLLAMA_MODELS="$root/models/ollama"
bin="$root/.runtime/ollama/bin/ollama"
if [[ ! -x "$bin" ]]; then bin=ollama; fi
exec "$bin" "$@"
